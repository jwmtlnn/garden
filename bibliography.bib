@article{lawAntComplexityNaming1999,
  title = {After {{Ant}}: {{Complexity}}, {{Naming}} and {{Topology}}},
  shorttitle = {After {{Ant}}},
  author = {Law, John},
  editor = {Hassard, John and Law, John},
  year = {1999},
