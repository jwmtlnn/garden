@misc{zhaoE2GraphRAGStreamliningGraphbased2025,
  title = {E{\textasciicircum}{{2GraphRAG}}: {{Streamlining Graph-based RAG}} for {{High Efficiency}} and {{Effectiveness}}},
  shorttitle = {E{\textasciicircum}{{2GraphRAG}}},
  author = {Zhao, Yibo and Zhu, Jiapeng and Guo, Ye and He, Kangkang and Li, Xiang},
  year = {2025},
  publisher = {arXiv},
  doi = {10.48550/ARXIV.2505.24226},
  urldate = {2026-11-01},
  abstract = {Graph-based RAG methods like GraphRAG have shown promising global understanding of the knowledge base by constructing hierarchical entity graphs. However, they often suffer from inefficiency and rely on manually pre-defined query modes, limiting practical use. In this paper, we propose E{\textasciicircum}2GraphRAG, a streamlined graph-based RAG framework that improves both Efficiency and Effectiveness. During the indexing stage, E{\textasciicircum}2GraphRAG constructs a summary tree with large language models and an entity graph with SpaCy based on document chunks. We then construct bidirectional indexes between entities and chunks to capture their many-to-many relationships, enabling fast lookup during both local and global retrieval. For the retrieval stage, we design an adaptive retrieval strategy that leverages the graph structure to retrieve and select between local and global modes. Experiments show that E{\textasciicircum}2GraphRAG achieves up to 10 times faster indexing than GraphRAG and 100 times speedup over LightRAG in retrieval while maintaining competitive QA performance.},
  copyright = {arXiv.org perpetual, non-exclusive license},
  keywords = {Artificial Intelligence (cs.AI),FOS: Computer and information sciences}
}
